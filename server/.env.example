PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# SQLite and disk uploads are local-development defaults only.
# DATABASE_PATH=./rentaway.db
# UPLOADS_DIR=./uploads
# Required in production: persistent PostgreSQL and image storage.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# RESEND_API_KEY=re_your_key
# MAIL_FROM=Rent-A-Way <support@your-verified-domain.example>
# Local reset emails are stored in .local-mail (never committed).
# Set these when bootstrapping the first production admin via the Render hook.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=use_a_unique_password_at_least_12_characters
