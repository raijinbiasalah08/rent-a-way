PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Optional local overrides; Render sets these to its persistent disk paths.
# DATABASE_PATH=./rentaway.db
# UPLOADS_DIR=./uploads
# Optional: required for real PayMongo checkout in production.
# PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
# Set these when bootstrapping the first production admin via the Render hook.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=use_a_unique_password_at_least_12_characters
